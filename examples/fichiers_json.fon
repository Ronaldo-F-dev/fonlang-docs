// Exemple fichiers et JSON

// Écrire un fichier texte
jo chemin = "/tmp/fon_exemple.txt"
wema_ecrire(chemin, "Bonjour depuis FonLang !")
xlɛ("Fichier créé :", wema_eɖe(chemin))

// Lire le fichier
jo contenu = wema_xa(chemin)
xlɛ("Contenu :", contenu)

// JSON — sérialisation
jo personne = { "nom": "Akɔ", "age": 28, "actif": nugbo }
jo json = json_ecrire(personne)
xlɛ("JSON :", json)

// JSON — désérialisation
jo retour = json_xa(json)
xlɛ("Nom :", retour["nom"])
xlɛ("Age :", retour["age"])

// Nettoyage
wema_sunsun(chemin)
xlɛ("Fichier supprimé :", !wema_eɖe(chemin))