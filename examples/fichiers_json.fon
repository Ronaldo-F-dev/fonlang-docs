// Exemple fichiers et JSON

// Écrire un fichier texte
jo chemin = "/tmp/fon_exemple.txt"
wlan_wema(chemin, "Bonjour depuis FonLang !")
xlɛ("Fichier créé :", eɖe_wema(chemin))

// Lire le fichier
jo contenu = xa_wema(chemin)
xlɛ("Contenu :", contenu)

// JSON — sérialisation
jo personne = { "nom": "Akɔ", "age": 28, "actif": nugbo }
jo json = wlan_json(personne)
xlɛ("JSON :", json)

// JSON — désérialisation
jo retour = xa_json(json)
xlɛ("Nom :", retour["nom"])
xlɛ("Age :", retour["age"])

// Nettoyage
sunsun_wema(chemin)
xlɛ("Fichier supprimé :", !eɖe_wema(chemin))